{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep", "WebFetch", "WebSearch",
      "Bash(git *)", "Bash(gh *)",
      "Bash(uv *)", "Bash(uvx *)", "Bash(python *)", "Bash(python3 *)", "Bash(pytest *)", "Bash(ruff *)",
      "Bash(pnpm *)", "Bash(npm *)", "Bash(npx *)", "Bash(node *)", "Bash(corepack *)",
      "Bash(ls *)", "Bash(ls)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)",
      "Bash(grep *)", "Bash(find *)", "Bash(sort *)", "Bash(diff *)", "Bash(echo *)", "Bash(pwd)",
      "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)", "Bash(rm *)", "Bash(touch *)", "Bash(cd *)",
      "Bash(curl *)", "Bash(gzip *)", "Bash(gunzip *)", "Bash(unzip *)", "Bash(jq *)", "Bash(sed *)"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)", "Bash(git reset --hard origin/main*)",
      "Bash(gh repo delete*)", "Bash(gh api -X PUT *merge*)", "Bash(gh pr merge*)",
      "Bash(gcloud *)", "Bash(firebase *)",
      "Bash(rm -rf /*)", "Bash(rm -rf ~*)", "Bash(rm -rf C:*)", "Bash(rm -rf /c/*)",
      "Read(./.env)", "Read(./.env.*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  }
}
