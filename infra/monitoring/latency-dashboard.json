{
  "displayName": "Travel Yantra latency (O3)",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 12, "height": 4,
        "widget": {
          "title": "p95 request latency by service (target < 3 s)",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "minAlignmentPeriod": "60s",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_DELTA",
                    "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                    "groupByFields": ["resource.label.\"service_name\""]
                  }
                }
              }
            }],
            "thresholds": [{ "label": "3 s target", "value": 3000 }],
            "yAxis": { "label": "ms", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0, "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "Uptime check latency (api /health and /guide/nearby, web / and /trip/live/)",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "minAlignmentPeriod": "60s",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/request_latency\" resource.type=\"uptime_url\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MEAN",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "groupByFields": ["metric.label.\"check_id\""]
                  }
                }
              }
            }],
            "yAxis": { "label": "ms", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6, "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "Uptime checks passing",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "minAlignmentPeriod": "60s",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" resource.type=\"uptime_url\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_FRACTION_TRUE",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "groupByFields": ["metric.label.\"check_id\""]
                  }
                }
              }
            }],
            "yAxis": { "label": "fraction", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0, "yPos": 8, "width": 6, "height": 4,
        "widget": {
          "title": "Requests per minute by service and response class",
          "xyChart": {
            "dataSets": [{
              "plotType": "STACKED_BAR",
              "minAlignmentPeriod": "60s",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_DELTA",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": ["resource.label.\"service_name\"", "metric.label.\"response_code_class\""]
                  }
                }
              }
            }]
          }
        }
      },
      {
        "xPos": 6, "yPos": 8, "width": 6, "height": 4,
        "widget": {
          "title": "Instances by service (min 0, max 2)",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "minAlignmentPeriod": "60s",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/container/instance_count\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": ["resource.label.\"service_name\""]
                  }
                }
              }
            }]
          }
        }
      }
    ]
  }
}
