# syntax=docker/dockerfile:1
# IndicTrans2 image (TY_TRANSLATOR=indictrans2, off since V3-W). Context: services/translate.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 TY_TRANSLATOR=indictrans2 HF_HOME=/models
WORKDIR /srv
COPY pyproject.toml ./
RUN pip install --extra-index-url https://download.pytorch.org/whl/cpu ".[model]"
COPY app ./app
# Bake the weights into the image so cold start does not download them. The repo is gated on
# Hugging Face: build with --secret id=hf_token,env=HF_TOKEN (the token never lands in a layer).
RUN --mount=type=secret,id=hf_token,env=HF_TOKEN python -c "from transformers import AutoModelForSeq2SeqLM as M, AutoTokenizer as T; n='ai4bharat/indictrans2-en-indic-dist-200M'; T.from_pretrained(n,trust_remote_code=True); M.from_pretrained(n,trust_remote_code=True)"
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
