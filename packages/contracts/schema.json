{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BudgetSummary": {
      "additionalProperties": false,
      "properties": {
        "transport_inr": {
          "minimum": 0,
          "title": "Transport Inr",
          "type": "integer"
        },
        "stay_inr": {
          "minimum": 0,
          "title": "Stay Inr",
          "type": "integer"
        },
        "activities_inr": {
          "default": 0,
          "minimum": 0,
          "title": "Activities Inr",
          "type": "integer"
        },
        "food_inr": {
          "default": 0,
          "minimum": 0,
          "title": "Food Inr",
          "type": "integer"
        },
        "total_inr": {
          "minimum": 0,
          "title": "Total Inr",
          "type": "integer"
        },
        "within_budget": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Within Budget"
        }
      },
      "required": [
        "transport_inr",
        "stay_inr",
        "total_inr"
      ],
      "title": "BudgetSummary",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "title"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CityRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "title": "Lng",
          "type": "number"
        }
      },
      "required": [
        "name",
        "lat",
        "lng"
      ],
      "title": "CityRef",
      "type": "object"
    },
    "CompareRequest": {
      "additionalProperties": false,
      "description": "Body of POST /routes/compare (TY3).",
      "properties": {
        "origin": {
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "destination": {
          "minLength": 1,
          "title": "Destination",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "depart_time": {
          "default": "08:00:00",
          "format": "time",
          "title": "Depart Time",
          "type": "string"
        },
        "rank_by": {
          "default": "balanced",
          "enum": [
            "balanced",
            "time",
            "cost",
            "changes"
          ],
          "title": "Rank By",
          "type": "string"
        },
        "modes": {
          "items": {
            "$ref": "#/$defs/Mode"
          },
          "minItems": 1,
          "title": "Modes",
          "type": "array"
        },
        "travellers": {
          "default": 1,
          "maximum": 20,
          "minimum": 1,
          "title": "Travellers",
          "type": "integer"
        }
      },
      "required": [
        "origin",
        "destination"
      ],
      "title": "CompareRequest",
      "type": "object"
    },
    "CompareResponse": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "$ref": "#/$defs/CityRef"
        },
        "destination": {
          "$ref": "#/$defs/CityRef"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "rank_by": {
          "enum": [
            "balanced",
            "time",
            "cost",
            "changes"
          ],
          "title": "Rank By",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/RankedOption"
          },
          "title": "Options",
          "type": "array"
        },
        "unavailable": {
          "items": {
            "$ref": "#/$defs/Unavailable"
          },
          "title": "Unavailable",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "origin",
        "destination",
        "date",
        "rank_by",
        "options"
      ],
      "title": "CompareResponse",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "budget_inr": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Inr"
        },
        "pace": {
          "$ref": "#/$defs/Pace",
          "default": "balanced"
        },
        "mobility_needs": {
          "items": {
            "type": "string"
          },
          "title": "Mobility Needs",
          "type": "array"
        },
        "dietary": {
          "items": {
            "type": "string"
          },
          "title": "Dietary",
          "type": "array"
        },
        "max_travel_hours_per_day": {
          "default": 8,
          "exclusiveMinimum": 0,
          "maximum": 24,
          "title": "Max Travel Hours Per Day",
          "type": "number"
        },
        "travellers": {
          "items": {
            "$ref": "#/$defs/Traveller"
          },
          "title": "Travellers",
          "type": "array"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "DayPlan": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "stops": {
          "items": {
            "$ref": "#/$defs/Place"
          },
          "title": "Stops",
          "type": "array"
        },
        "legs": {
          "items": {
            "$ref": "#/$defs/Leg"
          },
          "title": "Legs",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "date"
      ],
      "title": "DayPlan",
      "type": "object"
    },
    "GuideAnswer": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "emergency_places": {
          "items": {
            "$ref": "#/$defs/Place"
          },
          "title": "Emergency Places",
          "type": "array"
        },
        "lang": {
          "$ref": "#/$defs/Lang",
          "default": "en"
        }
      },
      "required": [
        "text"
      ],
      "title": "GuideAnswer",
      "type": "object"
    },
    "GuideQuestion": {
      "additionalProperties": false,
      "description": "Body of POST /guide/ask.",
      "properties": {
        "question": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "lang": {
          "$ref": "#/$defs/Lang",
          "default": "en"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "place_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Name"
        },
        "place_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Id"
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lng": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lng"
        },
        "has_elderly": {
          "default": false,
          "title": "Has Elderly",
          "type": "boolean"
        }
      },
      "required": [
        "question"
      ],
      "title": "GuideQuestion",
      "type": "object"
    },
    "Itinerary": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/TripRequest"
        },
        "days": {
          "items": {
            "$ref": "#/$defs/DayPlan"
          },
          "title": "Days",
          "type": "array"
        },
        "transport": {
          "items": {
            "$ref": "#/$defs/TransportOption"
          },
          "title": "Transport",
          "type": "array"
        },
        "stays": {
          "items": {
            "$ref": "#/$defs/Stay"
          },
          "title": "Stays",
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/BudgetSummary"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "lang": {
          "$ref": "#/$defs/Lang",
          "default": "en"
        }
      },
      "required": [
        "request",
        "days",
        "budget"
      ],
      "title": "Itinerary",
      "type": "object"
    },
    "KathaStory": {
      "additionalProperties": false,
      "properties": {
        "subject_kind": {
          "enum": [
            "place",
            "city",
            "day"
          ],
          "title": "Subject Kind",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "length_min": {
          "enum": [
            2,
            5,
            10
          ],
          "title": "Length Min",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/StorySegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "lang": {
          "$ref": "#/$defs/Lang",
          "default": "en"
        }
      },
      "required": [
        "subject_kind",
        "subject",
        "length_min",
        "text"
      ],
      "title": "KathaStory",
      "type": "object"
    },
    "Lang": {
      "enum": [
        "en",
        "hi",
        "kn",
        "ta",
        "te",
        "bn"
      ],
      "title": "Lang",
      "type": "string"
    },
    "Leg": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "depart": {
          "format": "date-time",
          "title": "Depart",
          "type": "string"
        },
        "arrive": {
          "format": "date-time",
          "title": "Arrive",
          "type": "string"
        },
        "minutes": {
          "minimum": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "cost_inr": {
          "minimum": 0,
          "title": "Cost Inr",
          "type": "integer"
        }
      },
      "required": [
        "from",
        "to",
        "mode",
        "depart",
        "arrive",
        "minutes",
        "cost_inr"
      ],
      "title": "Leg",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "road",
        "rail",
        "air"
      ],
      "title": "Mode",
      "type": "string"
    },
    "OpeningHours": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ],
          "title": "Day",
          "type": "string"
        },
        "opens": {
          "format": "time",
          "title": "Opens",
          "type": "string"
        },
        "closes": {
          "format": "time",
          "title": "Closes",
          "type": "string"
        }
      },
      "required": [
        "day",
        "opens",
        "closes"
      ],
      "title": "OpeningHours",
      "type": "object"
    },
    "Pace": {
      "enum": [
        "relaxed",
        "balanced",
        "packed"
      ],
      "title": "Pace",
      "type": "string"
    },
    "Place": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "native_names": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/Lang"
          },
          "title": "Native Names",
          "type": "object"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lng",
          "type": "number"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "opening_hours": {
          "items": {
            "$ref": "#/$defs/OpeningHours"
          },
          "title": "Opening Hours",
          "type": "array"
        },
        "typical_visit_minutes": {
          "minimum": 0,
          "title": "Typical Visit Minutes",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "lat",
        "lng",
        "category",
        "typical_visit_minutes",
        "source"
      ],
      "title": "Place",
      "type": "object"
    },
    "PlanEvent": {
      "additionalProperties": false,
      "description": "One Server-Sent Event of POST /plan. The stream ends after the first done, needs_input or error.",
      "properties": {
        "stage": {
          "$ref": "#/$defs/PlanStage"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "partial": {
          "anyOf": [
            {
              "$ref": "#/$defs/Itinerary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "step": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanStep"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Questions",
          "type": "array"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/Violation"
          },
          "title": "Violations",
          "type": "array"
        },
        "iteration": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iteration"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        },
        "share_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Share Token"
        }
      },
      "required": [
        "stage",
        "message"
      ],
      "title": "PlanEvent",
      "type": "object"
    },
    "PlanStage": {
      "enum": [
        "intake",
        "planning",
        "solving",
        "checking",
        "repairing",
        "narrating",
        "needs_input",
        "done",
        "error"
      ],
      "title": "PlanStage",
      "type": "string"
    },
    "PlanStep": {
      "description": "Which agent finished. Several steps share one stage (the four planners are all `planning`).",
      "enum": [
        "intake",
        "transport",
        "places",
        "stays",
        "story",
        "solver",
        "checker",
        "repair",
        "narrator"
      ],
      "title": "PlanStep",
      "type": "string"
    },
    "PlanText": {
      "additionalProperties": false,
      "description": "Free-text body for POST /plan; intake turns it into a TripRequest or asks questions.",
      "properties": {
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "lang": {
          "$ref": "#/$defs/Lang",
          "default": "en"
        }
      },
      "required": [
        "text"
      ],
      "title": "PlanText",
      "type": "object"
    },
    "RankedOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "changes": {
          "minimum": 0,
          "title": "Changes",
          "type": "integer"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "option": {
          "$ref": "#/$defs/TransportOption"
        }
      },
      "required": [
        "id",
        "rank",
        "changes",
        "score",
        "sources",
        "option"
      ],
      "title": "RankedOption",
      "type": "object"
    },
    "ReviseIntent": {
      "enum": [
        "lighter_day",
        "swap_stop",
        "rain"
      ],
      "title": "ReviseIntent",
      "type": "string"
    },
    "ReviseRequest": {
      "additionalProperties": false,
      "description": "Body of POST /plan/{plan_id}/revise. lighter_day needs day; swap_stop needs place_id; rain takes\nan optional day (all days when missing). The response streams PlanEvents like /plan.",
      "properties": {
        "intent": {
          "$ref": "#/$defs/ReviseIntent"
        },
        "day": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day"
        },
        "place_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Id"
        },
        "lang": {
          "anyOf": [
            {
              "$ref": "#/$defs/Lang"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "intent"
      ],
      "title": "ReviseRequest",
      "type": "object"
    },
    "SellerOffer": {
      "additionalProperties": false,
      "properties": {
        "seller": {
          "title": "Seller",
          "type": "string"
        },
        "price_inr": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Inr"
        },
        "currency": {
          "default": "INR",
          "title": "Currency",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deep_link",
            "check_price"
          ],
          "title": "Kind",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        }
      },
      "required": [
        "seller",
        "url",
        "kind",
        "fetched_at"
      ],
      "title": "SellerOffer",
      "type": "object"
    },
    "Stay": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "city": {
          "title": "City",
          "type": "string"
        },
        "check_in": {
          "format": "date",
          "title": "Check In",
          "type": "string"
        },
        "check_out": {
          "format": "date",
          "title": "Check Out",
          "type": "string"
        },
        "price_per_night_inr": {
          "minimum": 0,
          "title": "Price Per Night Inr",
          "type": "integer"
        },
        "offers": {
          "items": {
            "$ref": "#/$defs/SellerOffer"
          },
          "title": "Offers",
          "type": "array"
        }
      },
      "required": [
        "name",
        "city",
        "check_in",
        "check_out",
        "price_per_night_inr"
      ],
      "title": "Stay",
      "type": "object"
    },
    "StorySegment": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "legend",
            "history"
          ],
          "title": "Label",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "label",
        "text"
      ],
      "title": "StorySegment",
      "type": "object"
    },
    "TransportOption": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "legs": {
          "items": {
            "$ref": "#/$defs/Leg"
          },
          "minItems": 1,
